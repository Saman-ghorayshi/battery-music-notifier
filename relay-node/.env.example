# Copy to .env and fill in. NEVER commit the real .env.
NODE_ENV=production
PORT=8787

# postgres://user:password@host:5432/database
DATABASE_URL=postgres://battery:battery@127.0.0.1:55432/battery

# Long random secret for the admin API/dashboard (min 10 chars).
ADMIN_KEY=change-me-to-something-long-and-random

# Set to "false" to disable rate limiting (single-user self-host).
RATE_LIMIT_ENABLED=true

# Compose-only: password for the bundled Postgres container.
POSTGRES_PASSWORD=battery
